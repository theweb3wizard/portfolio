# Telegram Bot Token (from @BotFather on Telegram)
# 1. Open Telegram, search for @BotFather
# 2. Send /newbot and follow the prompts
# 3. Copy the token it gives you (format: 123456789:AAF...)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your personal Telegram Chat ID
# 1. Start a chat with your new bot (send it any message)
# 2. Visit https://api.telegram.org/bot{YOUR_TOKEN}/getUpdates in a browser
# 3. Find the "id" field inside "chat" in the response — that is your Chat ID
TELEGRAM_CHAT_ID=your_chat_id_here

# Fit-call booking URL (optional). When set, "Book a fit call" buttons link to
# your scheduler (e.g. Calendly). When empty, they route to /start?intent=fit-call
# so production never shows a dead link.
# Spec name: NEXT_PUBLIC_BOOKING_URL. This is a Vite app, so the VITE_ prefix is
# read first; either variable works.
VITE_BOOKING_URL=
NEXT_PUBLIC_BOOKING_URL=
